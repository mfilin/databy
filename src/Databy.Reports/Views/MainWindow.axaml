<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Databy.Reports.ViewModels"
        xmlns:views="using:Databy.Reports.Views"
        xmlns:local="using:Databy.Reports.Converters"
        x:Class="Databy.Reports.Views.MainWindow"
        Title="Отчётность"
        Width="1360" Height="820" MinWidth="1024" MinHeight="620"
        Background="#F4F7FB"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Surface">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceMuted">#F7F9FC</SolidColorBrush>
    <SolidColorBrush x:Key="BorderColor">#E3EAF3</SolidColorBrush>
    <SolidColorBrush x:Key="Primary">#2F80ED</SolidColorBrush>
    <SolidColorBrush x:Key="PrimarySoft">#EAF2FE</SolidColorBrush>
    <SolidColorBrush x:Key="AccentActive">#E5484D</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimary">#1F2A37</SolidColorBrush>
    <SolidColorBrush x:Key="TextMuted">#7A8899</SolidColorBrush>
    <local:DateTimeOffsetToDateTimeConverter x:Key="DtoToDtConverter" />
  </Window.Resources>

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ Button">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource PrimarySoft}" />
    </Style>
    <Style Selector="Calendar /template/ Button">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Calendar /template/ Button#PART_Button">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource PrimarySoft}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Primary}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.pager">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.pager:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource PrimarySoft}" />
    </Style>
    <Style Selector="Button.tabClose">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Button.tabClose:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FDE8E8" />
      <Setter Property="TextElement.Foreground" Value="#B42318" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="64,*,34">
    <!-- HEADER -->
    <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Primary}">
            <TextBlock Text="D" Foreground="White" FontWeight="Bold" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Databy Reports" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
            <TextBlock Text="Отчётность" FontSize="11" Foreground="{StaticResource TextMuted}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedTabTitle}"
                     VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
          <Button Classes="primary" Command="{Binding RunCommand}" Content="Обновить" Margin="8,0,0,0" />
          <Button Classes="tool" Command="{Binding CancelCommand}" Content="Отмена" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="tool" Command="{Binding ExportCommand}" Content="Экспорт" />
          <Button Classes="tool" Command="{Binding ReloadCatalogCommand}" Content="Перечитать каталог" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- BODY -->
    <Grid Grid.Row="1" Margin="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="180" MaxWidth="560" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="280" MinWidth="200" MaxWidth="520" />
      </Grid.ColumnDefinitions>

      <!-- LEFT SIDEBAR -->
      <Border Grid.Column="0" Background="{StaticResource Surface}" CornerRadius="10"
              BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Text="Каталог отчётов" FontWeight="SemiBold" FontSize="13" Margin="16,14,16,8"
                     Foreground="{StaticResource TextPrimary}" />
          <TreeView Grid.Row="1" ItemsSource="{Binding Catalog}" Background="Transparent" Margin="6,0" DoubleTapped="OnTreeDoubleTapped">
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:CatalogNode" ItemsSource="{Binding Children}">
                <Border CornerRadius="6" Padding="8,6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Icon}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                  </StackPanel>
                </Border>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <Border Grid.Row="2" Height="120" Margin="12" CornerRadius="8" Background="{StaticResource PrimarySoft}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
              <TextBlock Text="&#x1F465;" FontSize="34" HorizontalAlignment="Center" />
              <TextBlock Text="Команда" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    Background="{StaticResource BorderColor}" HorizontalAlignment="Stretch"
                    Width="8" Cursor="SizeWestEast" />

      <!-- CENTER CONTENT -->
      <Border Grid.Column="2" Background="{StaticResource Surface}" CornerRadius="10"
              BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              IsVisible="{Binding IsReportSelected}">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <TabControl Grid.Row="0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                      Background="Transparent" Padding="0">
            <TabControl.ItemTemplate>
              <DataTemplate DataType="vm:ReportTabViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6" DoubleTapped="OnTabDoubleTapped">
                  <ProgressBar IsIndeterminate="True" Width="16" Height="16" VerticalAlignment="Center"
                               IsVisible="{Binding IsLoading}"
                               Foreground="{StaticResource Primary}"
                               ToolTip.Tip="Выполняется запрос" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                  <Button Classes="tabClose" Content="✕" Click="OnTabCloseClick"
                          IsVisible="{Binding IsNotLoading}"
                          ToolTip.Tip="Закрыть вкладку" />
                </StackPanel>
              </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate DataType="vm:ReportTabViewModel">
                <Panel />
              </DataTemplate>
            </TabControl.ContentTemplate>
            <TabControl.ItemContainerTheme>
              <ControlTheme TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                <Setter Property="ContextMenu">
                  <Template>
                    <ContextMenu>
                      <MenuItem Header="Закрыть" Click="OnCloseTabMenuClick" />
                      <MenuItem Header="Закрыть остальные" Click="OnCloseOtherTabsMenuClick" />
                      <MenuItem Header="Закрыть все" Click="OnCloseAllTabsMenuClick" />
                    </ContextMenu>
                  </Template>
                </Setter>
              </ControlTheme>
            </TabControl.ItemContainerTheme>
          </TabControl>

          <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="tool" Command="{Binding RunCommand}" Content="Обновить" />
              <Button Classes="tool" Command="{Binding ExportCommand}" Content="Экспорт" />
              <Button Classes="tool" Command="{Binding FirstPageCommand}" Content="⏮" />
              <Button Classes="tool" Command="{Binding PreviousPageCommand}" Content="◀" />
              <Button Classes="tool" Command="{Binding NextPageCommand}" Content="▶" />
              <Button Classes="tool" Command="{Binding LastPageCommand}" Content="⏭" />
              <TextBlock Text="{Binding TotalCaption}" VerticalAlignment="Center" Margin="12,0,0,0"
                         Foreground="{StaticResource TextMuted}" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="2">
            <views:TableView Name="resultsTable"
                             IsVisible="{Binding HasData}"
                             ColumnsSource="{Binding SelectedTabColumns}"
                             RowsSource="{Binding SelectedTabRows}">
              <views:TableView.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="MinHeight" Value="32" />
                  <Setter Property="CornerRadius" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </views:TableView.Styles>
            </views:TableView>
            <StackPanel IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <TextBlock Text="&#x1F4C4;" FontSize="40" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource TextMuted}" FontSize="14"
                         HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Предпросмотр списка значений, пока отчёт не выполнен -->
            <Border IsVisible="{Binding HasListPreview}" Background="{StaticResource Surface}"
                    DataContext="{Binding SelectedListInput}">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Предпросмотр списка" FontWeight="SemiBold" FontSize="12" Margin="12,10,12,4"
                           Foreground="{StaticResource TextPrimary}" />
                <ScrollViewer Grid.Row="1">
                  <StackPanel Margin="12,0,12,12" Spacing="2">
                    <ItemsControl ItemsSource="{Binding PreviewHeaders}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="11" Width="140"
                                     Foreground="{StaticResource TextPrimary}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding PreviewRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:InputPreviewRowViewModel">
                          <ItemsControl ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" Width="140"
                                           TextTrimming="CharacterEllipsis" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>

            <Border IsVisible="{Binding SelectedTab.IsLoading}" Background="#66000000">
              <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="24,14"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <ProgressBar IsIndeterminate="True" Width="90" Height="4" VerticalAlignment="Center"
                               Foreground="{StaticResource Primary}" />
                  <TextBlock FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center">&gt;&gt;&gt;ЗАГРУЗКА ДАННЫХ&lt;&lt;&lt;</TextBlock>
                  <Button Classes="primary" Content="Отмена" Command="{Binding CancelCommand}" />
                </StackPanel>
              </Border>
            </Border>
          </Grid>

          <Border Grid.Row="3" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding TotalCaption}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="pager" Command="{Binding FirstPageCommand}" Content="«" />
                <Button Classes="pager" Command="{Binding PreviousPageCommand}" Content="‹" />
                <TextBlock Text="{Binding PageCaption}" VerticalAlignment="Center" Margin="8,0" />
                <Button Classes="pager" Command="{Binding NextPageCommand}" Content="›" />
                <Button Classes="pager" Command="{Binding LastPageCommand}" Content="»" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    Background="{StaticResource BorderColor}" HorizontalAlignment="Stretch"
                    Width="8" Cursor="SizeWestEast" />

      <!-- RIGHT SIDEBAR -->
      <Border Grid.Column="4" Background="{StaticResource Surface}" CornerRadius="10"
              BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              IsVisible="{Binding IsReportSelected}">
        <StackPanel Spacing="14" Margin="16">
          <TextBlock Text="Параметры" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
          <TextBlock Text="{Binding SelectedTabTitle}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
          <TextBlock Text="У отчёта нет параметров — он выполняется без входных значений."
                     IsVisible="{Binding HasNoParameters}"
                     Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
          <StackPanel Spacing="4" IsVisible="{Binding HasDateParameters}">
            <TextBlock Text="Дата с" Classes="caption" />
            <CalendarDatePicker SelectedDate="{Binding FilterFromDate, Converter={StaticResource DtoToDtConverter}, Mode=TwoWay}"
                                Watermark="Выберите дату" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Spacing="4" IsVisible="{Binding HasDateParameters}">
            <TextBlock Text="Дата по" Classes="caption" />
            <CalendarDatePicker SelectedDate="{Binding FilterToDate, Converter={StaticResource DtoToDtConverter}, Mode=TwoWay}"
                                Watermark="Выберите дату" HorizontalAlignment="Stretch" />
          </StackPanel>
          <Button Classes="primary" Command="{Binding RunCommand}" Content="Применить"
                  IsVisible="{Binding HasReportParameters}" HorizontalAlignment="Stretch" />

          <!-- Список значений -->
          <StackPanel Spacing="10" IsVisible="{Binding HasListInput}"
                      DataContext="{Binding SelectedListInput}">
            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,10,0,0" />
            <TextBlock Text="Список значений" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="tool" Command="{Binding PasteCommand}" Content="Вставить из буфера" />
              <Button Classes="tool" Command="{Binding LoadFileCommand}" Content="Загрузить файл…" />
              <Button Classes="tool" Command="{Binding ClearCommand}" Content="Очистить" />
            </StackPanel>
            <CheckBox IsChecked="{Binding FirstRowIsHeader, Mode=TwoWay}" Content="Первая строка — заголовок" />
            <TextBlock Text="{Binding SourceName}" Foreground="{StaticResource TextMuted}" FontSize="12"
                       IsVisible="{Binding HasSource}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Counters}" FontSize="12" Foreground="{StaticResource TextPrimary}" />
            <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsParsing}"
                         Foreground="{StaticResource Primary}" />
            <TextBlock Text="{Binding ParseError}" Foreground="#B42318" FontSize="12" TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{Binding Columns}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ColumnMappingViewModel">
                  <StackPanel Spacing="2" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Name}" Classes="caption" />
                    <ComboBox ItemsSource="{Binding SourceColumns}"
                              SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Ошибки" FontWeight="SemiBold" FontSize="12" IsVisible="{Binding HasErrors}" />
            <ListBox ItemsSource="{Binding Errors}" MaxHeight="120" IsVisible="{Binding HasErrors}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:InputErrorViewModel">
                  <TextBlock Text="{Binding Caption}" FontSize="11" TextWrapping="Wrap" Foreground="#B42318" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- STATUS BAR -->
    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="16,0">
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMuted}" />
        <TextBlock Grid.Column="1" Text="{Binding CatalogVersion, StringFormat='Каталог v{0}'}"
                   VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMuted}" />
      </Grid>
    </Border>
  </Grid>
</Window>